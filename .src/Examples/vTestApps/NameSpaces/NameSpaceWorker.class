' Gambas class file

' The other process of NameSpaceExample. It opens shop by name, makes the namespace stock, and changes
' orders:open:count, a namespace it did not make: it is opened because the segment exists

Inherits Task

Public Sub Main()

    Dim shop As New ShmMem("shop")

    shop.NewNameSpace(25000000, "stock")                       ' larger than the default 20MB
    shop["stock:apples"] = 42

    For i As Integer = 1 To 3
        shop["orders:open:count"] = i
        shop["orders:total"] = shop["orders:total"] + 10
        Wait 0.1
    Next

    shop["workerready"] = True
    shop.WaitForValue("done", True, 10)
    shop.Close()
    Quit 0

Catch
    Error "NameSpaceWorker : "; Error.Text, Error.Where
    Quit 1

End
