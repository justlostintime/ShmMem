' Gambas class file

Inherits Task
Public myindex As Integer = 0

Public Sub main() As String

    Print Application.id;; " BG Task Begins"
    Dim vmem As New ShmMem(1000000, "jiffy")

    Dim counter As Long = 0

    With vmem
        While True
            If Not .WaitValueChange("Wiggle", counter, 2) Then
                If !wiggle = counter Then
                    Print Application.id;; MyIndex;; " Timed out Waiting for change"
                Endif
            Else
                'Print Application.id;; MyIndex;; "Wiggle =";; !Wiggle
                counter = !Wiggle
            Endif

            If !AllDone == "Yes" Then
                'Print MyIndex;; "All done recieved , Wiggle =";; !Wiggle
                counter = !Wiggle
                Break
            Endif
        Wend

    End With

    Print Application.id;; ":";; MyIndex;; shmMem.GetObjectClass(Me).name;; "Completed with ";; counter
    vmem.Close()
    Return Hex(Application.id) & " " & Str(MyIndex) & " Done Counter =" & Str(counter)

Catch
    Print Application.id;; "Error:";; Error.text;; Error.where

End
