#!/usr/bin/env -S gbs3 -g

#Script Startup = "FMain"
#Script Version = "1.0.1"
Use "gb.image", "gb.gui", "gb.form"
Use ":westwood.shmmem:2.2"

' Gambas class file
Class FMain
Public MyMemory As ShmMem
Public variables As New Collection(gb.ignorecase)
Public SortedList As New String[]


Public Sub Form_Open()

    FMain.text = "Using SHM Monitor for shared heap 'MySharedMem' - SHM variable monitor V1 pid=" & application.id
    MyMemory = New ShmMem(2000000, "MySharedMem", 8000)          '' Open the test database
    MyMemory.NotifyOnNew(True, Me)                               '' get notified when new variables appear
    MyMemory.NotifyOnRemove(True, Me, "WhenRemoved")              '' get told when a variable is removed
    MyMemory.NotifyOnAny(True, Me, "WhenChanged")                  '' get told when any variable changes
    
    VariableList.Columns.count = 2
    VariableList.Columns[0].Title = "Variable Name"
    VariableList.Columns[1].Title = "Value"
    VariableList.Rows.count = 100
    For Each var As String In MyMemory
        'print "Adding";;MyMemory.key;;"value=";var
        variables.Add(var, MyMemory.key)
    Next
    SortedList = Variables.keys.sort()
    Every 5.0 Do VariableList.Refresh()
    
Catch
  Print "oops shmconsole";; error.txt;; error.where
End

Public Sub Form_Close()

    MyMemory.NotifyOnNew(False, Me)
    MyMemory.NotifyOnRemove(False, Me)
    MyMemory.NotifyOnAny(False, Me)
    MyMemory.close()
    
Catch
  Print "oops shmconsole";; error.txt;; error.where
End

'' Get the notifications
Public Sub OnNew_Created(SymName As String, value As Variant, TimedOut As Boolean)
    variables.Add(value, SymName)
    SortedList = Variables.keys.sort()
Catch
  Print "oops shmconsole";; error.txt;; error.where
End

Public Sub WhenRemoved(SymName As String, value As Variant, TimedOut As Boolean)
    Try variables.remove(SymName)
    SortedList = Variables.keys.sort()
Catch
  Print "oops shmconsole";; error.txt;; error.where
End

Public Sub WhenChanged(varname As String, value As Variant, timedOut As Boolean)

    If varname = "done" And value = True Then Quit 0
    If Variables.exist(varname) Then Variables[varname] = value ' sometimes the remove comes before the change, don't want to recreate
    
Catch
  Print "oops shmconsole";; error.txt;; error.where

End

Public Sub VariableList_Data(Row As Integer, Column As Integer)
 
    If Row > SortedList.max Then Return
    If column = 0 Then
        VariableList.Data.text = SortedList[row]
    Else
        VariableList.Data.text = Str(Variables[SortedList[row]])
    Endif
    
Catch
  Print "oops shmconsole";; error.txt;; error.where
  
End


End Class

form FMain
#Gambas Form File 3.0

{  Form Form
  MoveScaled(0, 0, 136, 73)
  { !VariableList GridView
    MoveScaled(1, 0, 133, 71)
    #Public = True
    Expand = True
    Header = GridView.Horizontal
    ScrollBar = Scroll.Vertical
    Sorted = True
  }
}

End form
